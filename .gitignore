# Environments & Secrets (CRITICAL)
.env
.venv
env/
venv/

# Database files
cases.db
*.sqlite3

# Generated report outputs (produced by running the CLI/GUI locally)
[Rr]eport_*.xlsx

# Excel lock files (created while a workbook is open in Excel)
~$*.xlsx

# PyInstaller build artifacts (build.py output)
build/
dist/
*.spec

# Python build & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# IDEs
.idea/
.vscode/

# uv / package manager
.uv_cache

# Windows/WSL zone metadata
*:Zone.Identifier